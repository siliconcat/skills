#!/usr/bin/env bash
# Start a director worker as a Herdr terminal:
#   hc-worker [--repo <dir>] <name> <role> <model> <effort> [-- <claude args>...]
# The brief comes on stdin. --repo starts the worker in another repo, with that repo's own role,
# CLAUDE.md and settings. It refuses, with exit 2, anything that would leave the worker waiting
# at a prompt only the user can answer, so the director spawns a subagent or asks the user instead.
# Each worker is appended to director/workers.tsv in the home project, tab-separated: time (UTC), name,
# role, cwd, worker session id, Herdr terminal, director session id (director-retro reads it).
set -euo pipefail

usage="usage: hc-worker [--repo <dir>] <name> <role> <model> <effort> [-- <claude args>...] < brief"
refuse() { echo "hc-worker: $1" >&2; exit 2; }
home=$(pwd -P) home_l=$PWD repo=""
if [[ ${1:-} == --repo ]]; then
  [[ $# -ge 2 ]] || { echo "$usage" >&2; exit 1; }
  repo=$2; shift 2
  cd "$repo" 2>/dev/null || refuse "no such folder: $repo"
fi
[[ $# -ge 4 ]] || { echo "$usage" >&2; exit 1; }
name=$1 role=$2 model=$3 effort=$4; shift 4
[[ ${1:-} == -- ]] && shift

[[ -n ${HC_TERMINAL_ID:-} ]] || refuse "not in a Herdr terminal (HC_TERMINAL_ID unset): spawn a subagent"
command -v hc >/dev/null || refuse "hc is not on the PATH: spawn a subagent"
[[ -f .claude/agents/$role.md ]] || refuse "no role file .claude/agents/$role.md in $PWD: run hc-worker from the project root, or pass --repo"

# Claude Code asks once per folder whether to trust it; a trusted folder covers its subfolders.
config=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
trusted=$(jq -r '.projects // {} | to_entries[] | select(.value.hasTrustDialogAccepted == true) | .key' "$config" 2>/dev/null || true)
is_trusted() {
  local d
  for d in "$PWD" "$(pwd -P)"; do
    while :; do
      grep -qxF -- "$d" <<< "$trusted" && return 0
      [[ $d == / ]] && break
      d=$(dirname "$d")
    done
  done
  return 1
}
is_trusted || refuse "$PWD is not a trusted folder: the worker would wait at the trust prompt. Ask the user to open Claude here once and trust it"

brief=$(cat)
[[ -n $brief ]] || refuse "empty brief on stdin"
# A relative report path would land in the other repo, out of the director's sight.
[[ -z $repo || $brief == *"$home/director/reports/"* || $brief == *"$home_l/director/reports/"* ]] ||
  refuse "with --repo, the brief must name the report as an absolute path under $home/director/reports/"
# The worker's session id is chosen here, so director-retro can find its transcript later, in any project folder.
sid=$(uuidgen | tr 'A-Z' 'a-z')
out=$(hc run --bg --name "$name" --label "director.role=$role" \
  claude --agent "$role" --model "$model" --effort "$effort" --session-id "$sid" "$@" "$brief") || { printf '%s\n' "$out" >&2; exit 1; }
mkdir -p "$home/director"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" "$role" "$(pwd -P)" "$sid" \
  "$(jq -r '.address // empty' <<< "$out" 2>/dev/null || true)" "${CLAUDE_CODE_SESSION_ID:-}" >> "$home/director/workers.tsv"
printf '%s\n' "$out"
