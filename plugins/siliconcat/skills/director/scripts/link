#!/usr/bin/env bash
# Point ~/.local/share/director/bin at the scripts beside this file: role files, hooks and the band
# call that fixed path, so the installed copy can move (plugin upgrades) without breaking them.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
dest=${DIRECTOR_BIN:-$HOME/.local/share/director/bin}

if [[ -e $dest && ! -L $dest ]]; then
  echo "link: $dest exists and is not a link; leaving it alone" >&2
  exit 1
fi
mkdir -p "$(dirname "$dest")"
# Directors on different plugin versions share this link: one still on an older copy must not take it back.
version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$1/../../../.claude-plugin/plugin.json" 2>/dev/null | head -1; }
cur=$(readlink "$dest" 2>/dev/null || true)
mine=$(version "$here")
theirs=$([[ -d $cur ]] && version "$cur" || true)
if [[ -n $mine && -n $theirs && $theirs != "$mine" && $(printf '%s\n' "$mine" "$theirs" | sort -V | tail -1) == "$theirs" ]]; then
  echo "director scripts: $dest -> $cur ($theirs, newer than this copy's $mine; left as is)"
else
  [[ $cur == "$here" ]] || ln -sfn "$here" "$dest"
  echo "director scripts: $dest -> $here"
fi
# The director can't see its environment, so say here, in a run it always makes, when hc.md applies (the Herdr app, or the standalone herdr server).
if [[ -n ${HC_TERMINAL_ID:-} ]] && command -v hc > /dev/null; then
  echo "Herdr terminal $HC_TERMINAL_ID: read hc.md now and start workers with hc-worker, not subagents"
elif [[ ${HERDR_ENV:-} == 1 && -n ${HERDR_PANE_ID:-} ]] && command -v herdr > /dev/null; then
  echo "Herdr pane $HERDR_PANE_ID: read hc.md now and start workers with hc-worker, not subagents"
fi
